.env
.env.*
!.env.example

# Настройки IDE и редакторов
.vscode/
.idea/
*.swp
*.swo

# Базы данных и временные файлы хранилища
*.sqlite3
*.db
*.log

# Кэш тестов и линтеров
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Специфика ОС
.DS_Store
Thumbs.db